<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gitquest.ui.entry.EntryController"
            styleClass="root">
    <center>
        <VBox alignment="TOP_CENTER" spacing="32" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="48" right="48" bottom="48" left="48"/>
            </padding>
            <Label text="GitQuest" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: -git-accent;"/>
            <VBox alignment="TOP_CENTER" spacing="24" maxWidth="480">

                <!-- Clone -->
                <VBox spacing="6">
                    <Label text="Clone" styleClass="section-heading"/>
                    <Label text="Clone a remote repository to a local folder." wrapText="true" styleClass="sub-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <TextField fx:id="cloneUrlField" promptText="https://github.com/example/repo.git" prefWidth="320"/>
                        <Button fx:id="cloneButton" text="Clone..." styleClass="accent"/>
                    </HBox>
                </VBox>

                <!-- Open -->
                <VBox spacing="6">
                    <Label text="Open" styleClass="section-heading"/>
                    <Label text="Open an existing local folder. If it's not a Git repository yet, you'll be offered the chance to initialize it." wrapText="true" styleClass="sub-label"/>
                    <HBox spacing="8">
                        <Button fx:id="openButton" text="Open..."/>
                    </HBox>
                </VBox>

                <!-- Initialize -->
                <VBox spacing="6">
                    <Label text="Initialize" styleClass="section-heading"/>
                    <Label text="Start a brand new repository from scratch." wrapText="true" styleClass="sub-label"/>
                    <HBox spacing="8">
                        <Button fx:id="initializeButton" text="Initialize..."/>
                    </HBox>
                </VBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>
