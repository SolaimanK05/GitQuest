<?xml version="1.0" encoding="UTF-8"?>

<?import com.gitquest.ui.sandbox.CommitGraphView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gitquest.ui.tutorial.TutorialController"
            styleClass="root">

    <top>
        <VBox styleClass="status-bar" spacing="4">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="arcLabel" styleClass="section-heading"/>
                <Label fx:id="titleLabel" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="progressLabel" styleClass="sub-label"/>
                <Button fx:id="skipButton" text="Skip Tutorial">
                    <tooltip>
                        <javafx.scene.control.Tooltip text="Skip straight to the graded objective."/>
                    </tooltip>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="false" fitToHeight="false">
            <content>
                <CommitGraphView fx:id="commitGraphView"/>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox styleClass="status-bar" spacing="10">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <Label fx:id="commandLabel" wrapText="true" styleClass="tutorial-command-label" visible="false" managed="false"/>
            <Label fx:id="narrationLabel" wrapText="true" style="-fx-font-size: 14px;"/>
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="nextButton" text="Next" styleClass="accent" minWidth="140"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
