<?xml version="1.0" encoding="UTF-8"?>

<?import com.gitquest.ui.home.SkillTreeThumbnail?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gitquest.ui.home.HomeController"
            styleClass="root">
    <center>
        <VBox alignment="CENTER" spacing="24" styleClass="home-backdrop" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="48" right="48" bottom="48" left="48"/>
            </padding>
            <Label text="GitQuest" styleClass="text-display" style="-fx-text-fill: -git-accent;"/>
            <Label text="Learn Git by doing it." styleClass="sub-label, text-body-medium"/>

            <SkillTreeThumbnail fx:id="skillTreeThumbnail"/>

            <VBox alignment="CENTER" spacing="12" maxWidth="280">
                <Button fx:id="campaignButton" text="Guided Campaign" styleClass="accent" maxWidth="Infinity"/>
                <Button fx:id="sandboxButton" text="Enter Sandbox" maxWidth="Infinity"/>
                <Button fx:id="collaborationButton" text="Collaboration Demo" maxWidth="Infinity">
                    <tooltip>
                        <Tooltip text="Two independent clones sharing one local &quot;origin&quot;. Push/fetch/pull between them to see real divergence and conflicts."/>
                    </tooltip>
                </Button>
            </VBox>
        </VBox>
    </center>
</BorderPane>
