<?xml version="1.0" encoding="UTF-8"?>

<?import com.gitquest.ui.home.SkillTreeThumbnail?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gitquest.ui.home.HomeController"
            styleClass="root">
    <center>
        <VBox alignment="CENTER" spacing="24" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="48" right="48" bottom="48" left="48"/>
            </padding>
            <Label text="GitQuest" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: -git-accent;"/>
            <Label text="Learn Git by doing it." styleClass="sub-label"/>

            <SkillTreeThumbnail fx:id="skillTreeThumbnail"/>

            <VBox alignment="CENTER" spacing="12" maxWidth="280">
                <Button fx:id="campaignButton" text="Guided Campaign" styleClass="accent" maxWidth="Infinity"/>
                <Button fx:id="sandboxButton" text="Enter Sandbox" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
