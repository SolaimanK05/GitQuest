<?xml version="1.0" encoding="UTF-8"?>

<?import com.gitquest.ui.campaign.SkillTreeView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gitquest.ui.campaign.CampaignController"
            styleClass="root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-bar">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Button fx:id="backButton" text="&#8592; Home"/>
            <Label text="Guided Campaign" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="false" fitToHeight="false">
            <content>
                <SkillTreeView fx:id="skillTreeView"/>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
