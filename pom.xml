<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.gitquest</groupId>
  <artifactId>gitquest</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>GitQuest</name>
  <description>Interactive Git learning app: guided campaign + animated sandbox visualization.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javafx.version>21.0.11</javafx.version>
    <jgit.version>7.7.1.202607240634-r</jgit.version>
    <javaparser.version>3.28.2</javaparser.version>
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    <junit.version>5.11.4</junit.version>

    <!-- Entry point used by the javafx-maven-plugin (mvn javafx:run). Eclipse's
         "Run As -> Java Application" instead targets com.gitquest.app.Launcher directly. -->
    <app.mainClass>com.gitquest.app.GitQuestApp</app.mainClass>
  </properties>

  <dependencies>
    <!-- JavaFX. The classifier (win/mac/linux) is set per-OS by the profiles below —
         the unclassified javafx-* artifacts are near-empty stub jars with no real
         classes, so an unresolved/missing classifier here silently produces
         "NoClassDefFoundError: Stage" at runtime instead of a build failure. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>

    <!-- Git engine -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>${jgit.version}</version>
    </dependency>

    <!-- Code structure analysis (not used yet this phase; pinned for the team) -->
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
      <version>${javaparser.version}</version>
    </dependency>

    <!-- Local persistence (not used yet this phase; pinned for the team) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- Fallback launch path: mvn javafx:run, or Eclipse "Run As -> Maven build..."
           with goal "javafx:run". Day-to-day dev should just use Run As -> Java
           Application on com.gitquest.app.Launcher (no VM args needed). -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${app.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Sets javafx.platform per teammate's OS. Plain Maven <profiles> instead of
       os-maven-plugin: a build extension needs m2e's embedded Maven to reprocess
       the pom on every edit to pick it up, which it doesn't reliably do —
       profile activation is core Maven behavior and just works in Eclipse. -->
  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>linux</id>
      <activation>
        <os>
          <family>unix</family>
          <name>!mac os x</name>
        </os>
      </activation>
      <properties>
        <javafx.platform>linux</javafx.platform>
      </properties>
    </profile>
  </profiles>
</project>
